;; Local overrides for Agent Safehouse
;; Symlinked from ~/projects/github.com/revett/dotfiles

;; Allow reading and writing to ~/Downloads (used by invoice generation and accessing images etc)
(allow file-read*
  (home-subpath "/Downloads"))
(allow file-write*
  (home-subpath "/Downloads"))

;; cmux CLI talks to the app over a unix socket; connect() is network-outbound,
;; so --add-dirs on the socket directory is not enough.
(allow network-outbound
  (remote unix-socket (path-regex (string-append "^" HOME_DIR "/\\.local/state/cmux/[^/]+\\.sock$"))))
